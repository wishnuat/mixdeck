{
  "manifest_version": 3,
  "name": "Mixdeck: tab volume",
  "short_name": "Mixdeck",
  "version": "0.2.0",
  "description": "Per-tab volume for Chrome and Edge. Works on its own, and appears inside the Mixdeck tray mixer when it's running.",
  "key": "",
  "permissions": ["tabs", "nativeMessaging", "storage"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["page-gain.js"],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true,
      "world": "MAIN"
    },
    {
      "matches": ["<all_urls>"],
      "js": ["relay.js"],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true
    }
  ],
  "action": { "default_title": "Mixdeck: tab volume", "default_popup": "popup.html" },
  "icons": { "32": "icons/32.png", "128": "icons/128.png" }
}
